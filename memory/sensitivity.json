{
 "perturbations": [
  {
   "name": "spread_k_x0.8",
   "parameter": "liquidity.spread_k_ticks",
   "baseline": 0.05,
   "value": 0.04,
   "kind": "config",
   "why": "The quoted-spread coefficient is a SIM CHOICE: 20% tighter quotes everywhere, with the per-tier tick bounds unchanged."
  },
  {
   "name": "spread_k_x1.2",
   "parameter": "liquidity.spread_k_ticks",
   "baseline": 0.05,
   "value": 0.06,
   "kind": "config",
   "why": "The same choice in the other direction: 20% wider quotes."
  },
  {
   "name": "spread_ticks_plus1",
   "parameter": "liquidity min/max_spread_ticks",
   "baseline": "mega 1-3 \u2026 micro 2-30",
   "value": "every tier +1",
   "kind": "config",
   "why": "The literal venue perturbation: the quoted spread is one tick wider wherever a bound binds, which is what a reader pictures when they ask how much a tick of spread costs a strategy. Every tier's floor and ceiling moves; the size of the move in cents is therefore price-dependent, exactly as it is in the market."
  },
  {
   "name": "spread_ticks_minus1",
   "parameter": "liquidity min/max_spread_ticks",
   "baseline": "mega 1-3 \u2026 micro 2-30",
   "value": "every tier -1 (floor 1)",
   "kind": "config",
   "why": "The other side of the same venue rule: one tick tighter, with the floor held at one tick because a one-tick quote is the tightest any venue can publish. It is also the direction that makes the MODEL's choice of per-tier ceilings visible as a cost."
  },
  {
   "name": "depth_growth_1.2",
   "parameter": "liquidity.depth_growth",
   "baseline": 1.6,
   "value": 1.2,
   "kind": "config",
   "why": "How fast displayed size grows away from the touch. A flatter ladder: less size behind the touch at every level above it."
  },
  {
   "name": "depth_growth_2.0",
   "parameter": "liquidity.depth_growth",
   "baseline": 1.6,
   "value": 2.0,
   "kind": "config",
   "why": "A steeper ladder: more size one and two levels in."
  },
  {
   "name": "hidden_liquidity_off",
   "parameter": "liquidity.hidden_liquidity",
   "baseline": true,
   "value": false,
   "kind": "config",
   "why": "Non-displayed liquidity at the touch models the off-exchange share of volume (FINRA OTC Transparency). Turning it off is the conservative case: only the displayed ladder can fill."
  },
  {
   "name": "impact_coef_x0.8",
   "parameter": "impact.coefficient",
   "baseline": 0.55,
   "value": 0.44,
   "kind": "config",
   "why": "The square-root impact coefficient is a SIM CHOICE inside the published 0.1-1.0 range; this is its lower edge."
  },
  {
   "name": "impact_coef_x1.2",
   "parameter": "impact.coefficient",
   "baseline": 0.55,
   "value": 0.66,
   "kind": "config",
   "why": "The same square-root coefficient 20% higher: 0.66 instead of 0.55, still inside the published 0.1-1.0 range."
  },
  {
   "name": "impact_exponent_0.6",
   "parameter": "impact_exponent",
   "baseline": 0.5,
   "value": 0.6,
   "kind": "venue",
   "why": "IR-26: Almgren, Thum, Hauptmann & Li (2005) measured a 3/5 power law and explicitly rejected the square root for temporary impact. The exponent is a model form, not a config value, so it moves as a venue override."
  },
  {
   "name": "tick_snap_off",
   "parameter": "snap_quotes_to_tick",
   "baseline": true,
   "value": false,
   "kind": "venue",
   "why": "IR-29: without snapping, the re-centred ladder publishes prices that are not on the Rule 612 grid - what the engine did before IR-28. The published season is the snapped one; this measures what half a tick is worth to the ranking."
  },
  {
   "name": "makers_3",
   "parameter": "market_maker.num_makers",
   "baseline": 4,
   "value": 3,
   "kind": "config",
   "why": "Number of competing market makers (Avellaneda-Stoikov, SIM CHOICE): one fewer dealer quoting each side."
  },
  {
   "name": "taker_fee_x1.5",
   "parameter": "costs.taker_fee_per_share",
   "baseline": 0.003,
   "value": 0.0045,
   "kind": "config",
   "why": "The taker fee sits at the Rule 610(c) access-fee cap; this asks what a cap 50% higher would have done. A legal constant does not move in the model - it is perturbed here only as a cost sensitivity."
  },
  {
   "name": "maker_rebate_off",
   "parameter": "costs.maker_rebate_per_share",
   "baseline": 0.002,
   "value": 0.0,
   "kind": "config",
   "why": "Maker rebates to zero: the case where passive liquidity is not paid for its fill."
  }
 ],
